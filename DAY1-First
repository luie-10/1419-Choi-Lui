using System;

namespace MyFirstApp
{
    internal class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("GAME START");
            float playerNowHP = 100;
            float playerMaxHP = 100;
            float monsterHP = 100;
            float monsterMaxHP = 100;
            bool isDefending = false;
            float PlayerAK = 10;
            float MonsterAK = 10;
            int turnCount = 1;
            
            while (playerNowHP > 0 && monsterHP > 0)
            {
                Console.WriteLine("\n--------------------------------");
                if (turnCount % 3 == 0)
                {
                    Console.WriteLine("몬스터가 공격성이 강화 되었습니다!");
                    MonsterAK += 3;
                }
                Console.WriteLine($"플레이어 HP: {playerNowHP}/{playerMaxHP} | 몬스터 HP: {monsterHP}/{monsterMaxHP}");
                Console.Write("공격 (A) / 회복 (H) / 방어 (D) / 아이템 (I) : ");

                char choice = char.ToUpper(Console.ReadKey().KeyChar);
                Console.WriteLine();

                Player(choice, ref playerNowHP, ref monsterHP, ref isDefending, ref PlayerAK, ref playerMaxHP);

                if (monsterHP > 0)
                {
                    Monster(ref playerNowHP, ref isDefending, ref MonsterAK, ref turnCount);
                }
            }

            if (playerNowHP <= 0)
            {
                Console.WriteLine("\n패배했습니다... GAME OVER");
            }
            else if (monsterHP <= 0)
            {
                Console.WriteLine("\n축하합니다! 몬스터를 처치했습니다!");
            }
        }

        static void Player(char choice, ref float nowPlayerHP, ref float monsterHP, ref bool isDefending, ref float PlayerAK, ref float playerMaxHP)
        {
            Random random = new Random();

            if (choice == 'A')
            {
                int criticalChance = random.Next(1, 101); // 1~100 사이의 랜덤 값 생성

                int attackDamage = random.Next((int)PlayerAK - 9, (int)PlayerAK + 2);
                if (criticalChance <= 20) // 20% 확률로 크리티컬 히트
                {
                    attackDamage *= 2;
                    Console.WriteLine("크리티컬 히트!");
                }
                monsterHP -= attackDamage;
                Console.WriteLine($"몬스터에게 {attackDamage}의 데미지를 입혔습니다");
            }
            else if (choice == 'H')
            {
                int healAmount = 10;
                nowPlayerHP += healAmount;
                if (nowPlayerHP > playerMaxHP)
                {
                    nowPlayerHP = playerMaxHP; // 최대 체력 초과 방지
                }
                healAmount = (int)(nowPlayerHP > playerMaxHP ? playerMaxHP - (nowPlayerHP - healAmount) : healAmount);
                Console.WriteLine($"체력을 {healAmount} 회복했습니다");
            }
            else if (choice == 'D')
            {
                isDefending = true;
                Console.WriteLine("방어 상태가 되었습니다.");
            }
            else if (choice == 'I')
            {
                
                Console.Write("광폭화 포션(F) / 날카로운 포션(N) : ");
                char itemChoice = char.ToUpper(Console.ReadKey().KeyChar);
                Console.WriteLine();

                
                Item(itemChoice, ref PlayerAK, ref monsterHP);
            }
            else
            {
                Console.WriteLine("잘못된 입력입니다.");
            }

        }

        static void Item(char itemChoice, ref float PlayerAK, ref float monsterHP)
        {
            Random random = new Random();

            if (itemChoice == 'F')
            {
                PlayerAK += 5;
                Console.WriteLine("광폭화 포션을 사용하여 공격력이 증가했습니다.");
            }
            else if (itemChoice == 'N')
            {
                PlayerAK += 10;
                Console.WriteLine("날카로운 포션을 사용하여 공격력이 증가했습니다.");

                
                int attackDamage = random.Next((int)PlayerAK - 5, (int)PlayerAK - 2);
                monsterHP -= attackDamage;
                Console.WriteLine($"날카로운 포션의 효과로 몬스터에게 {attackDamage}의 데미지를 입혔습니다!");
            }
            else
            {
                Console.WriteLine("잘못된 아이템 선택입니다.");
            }
        }

        static void Monster(ref float playerHP, ref bool isDefending, ref float MonsterAK, ref int turnCount)
        {
            Random random = new Random();
            int attackDamage = random.Next((int)MonsterAK - 5, (int)MonsterAK + 5);
            if (isDefending)
            {
                attackDamage /= 2; // 방어 상태에서는 받는 데미지 절반
            }
            playerHP -= attackDamage;
            if (isDefending)
            {
                Console.WriteLine($"Monster가 공격했습니다 하지만 방어를 해 데미지가 1/2가 되었습니다. (데미지: {attackDamage})");
                isDefending = false; // 방어 상태 해제
                turnCount++;
            }
            else
            {
                Console.WriteLine($"Monster가 공격했습니다 (데미지: {attackDamage})");
                turnCount++;
            }
        }
    }
}
