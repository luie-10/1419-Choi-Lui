using System;

namespace MyFirstApp
{
    class Unit
    {
        public string Name { get; set; }
        public float MaxHP { get; set; }
        public float NowHP { get; set; }
        public float AttackPower { get; set; }

        public Unit(string name, float hp, float attackPower)
        {
            Name = name;
            MaxHP = hp;
            NowHP = hp;
            AttackPower = attackPower;
        }

        public bool IsDead => NowHP <= 0;

        public void TakeDamage(float damage)
        {
            NowHP -= damage;
            if (NowHP < 0) NowHP = 0;
        }

        public void Heal(float amount)
        {
            NowHP += amount;
            if (NowHP > MaxHP) NowHP = MaxHP;
        }
    }

    internal class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("GAME START");

            Unit player = new Unit("플레이어", 100, 10);
            Unit monster = new Unit("몬스터", 100, 10);

            bool isDefending = false;
            int turnCount = 1;

            while (!player.IsDead && !monster.IsDead)
            {
                Console.WriteLine("\n--------------------------------");
                if (turnCount % 3 == 0)
                {
                    Console.WriteLine("몬스터가 공격성이 강화 되었습니다!");
                    monster.AttackPower += 3;
                }

                Console.WriteLine($"플레이어 HP: {player.NowHP}/{player.MaxHP} | 몬스터 HP: {monster.NowHP}/{monster.MaxHP}");
                Console.Write("공격 (A) / 회복 (H) / 방어 (D) / 아이템 (I) : ");

                char choice = char.ToUpper(Console.ReadKey().KeyChar);
                Console.WriteLine();

                PlayerTurn(choice, player, monster, ref isDefending);

                if (!monster.IsDead)
                {
                    MonsterTurn(player, monster, ref isDefending, ref turnCount);
                }
            }

            if (player.IsDead)
            {
                Console.WriteLine("\n패배했습니다... GAME OVER");
            }
            else if (monster.IsDead)
            {
                Console.WriteLine("\n축하합니다! 몬스터를 처치했습니다!");
            }
        }

        static void PlayerTurn(char choice, Unit player, Unit monster, ref bool isDefending)
        {
            Random random = new Random();

            if (choice == 'A')
            {
                int criticalChance = random.Next(1, 101);
                int attackDamage = random.Next((int)player.AttackPower - 9, (int)player.AttackPower + 2);

                if (criticalChance <= 20)
                {
                    attackDamage *= 2;
                    Console.WriteLine("크리티컬 히트!");
                }

                monster.TakeDamage(attackDamage);
                Console.WriteLine($"몬스터에게 {attackDamage}의 데미지를 입혔습니다");
            }
            else if (choice == 'H')
            {
                float beforeHP = player.NowHP;
                player.Heal(10);
                float actualHealed = player.NowHP - beforeHP;

                Console.WriteLine($"체력을 {actualHealed} 회복했습니다");
            }
            else if (choice == 'D')
            {
                isDefending = true;
                Console.WriteLine("방어 상태가 되었습니다.");
            }
            else if (choice == 'I')
            {
                Console.Write("광폭화 포션(F) / 날카로운 포션(N) : ");
                char itemChoice = char.ToUpper(Console.ReadKey().KeyChar);
                Console.WriteLine();

                Item(itemChoice, player, monster);
            }
            else
            {
                Console.WriteLine("잘못된 입력입니다.");
            }
        }

        static void Item(char itemChoice, Unit player, Unit monster)
        {
            Random random = new Random();

            if (itemChoice == 'F')
            {
                player.AttackPower += 5;
                Console.WriteLine("광폭화 포션을 사용하여 공격력이 증가했습니다.");
            }
            else if (itemChoice == 'N')
            {
                player.AttackPower += 10;
                Console.WriteLine("날카로운 포션을 사용하여 공격력이 증가했습니다.");

                int attackDamage = random.Next((int)player.AttackPower - 5, (int)player.AttackPower - 2);
                monster.TakeDamage(attackDamage);
                Console.WriteLine($"날카로운 포션의 효과로 몬스터에게 {attackDamage}의 데미지를 입혔습니다!");
            }
            else
            {
                Console.WriteLine("잘못된 아이템 선택입니다.");
            }
        }

        static void MonsterTurn(Unit player, Unit monster, ref bool isDefending, ref int turnCount)
        {
            Random random = new Random();
            int attackDamage = random.Next((int)monster.AttackPower - 5, (int)monster.AttackPower + 5);

            if (isDefending)
            {
                attackDamage /= 2;
            }

            player.TakeDamage(attackDamage);

            if (isDefending)
            {
                Console.WriteLine($"Monster가 공격했습니다 하지만 방어를 해 데미지가 1/2가 되었습니다. (데미지: {attackDamage})");
                isDefending = false;
            }
            else
            {
                Console.WriteLine($"Monster가 공격했습니다 (데미지: {attackDamage})");
            }

            turnCount++;
        }
    }
}
